# --- Option A: local Ollama (default) ---
LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434

# --- Option B: hosted API (works on any cloud host, no GPU needed) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1      # or https://api.groq.com/openai/v1, https://openrouter.ai/api/v1
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
# Groq/OpenRouter chat has no embeddings; point embeddings at OpenAI separately:
# EMBED_API_KEY=sk-...
# EMBED_BASE_URL=https://api.openai.com/v1

# --- Protect a public deployment ---
# APP_PASSWORD=choose-something-long
# DATA_DIR=/data        # where chat_history.db and chroma_db live (mount a persistent disk here)
